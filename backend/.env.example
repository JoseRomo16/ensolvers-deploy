# PostgreSQL connection string.
# Local development through docker-compose uses the value below; ./start.sh
# injects the container hostname automatically when running inside Docker.
DATABASE_URL=postgres://notes:notes@localhost:5432/notes

# For Supabase, use the SESSION POOLER string (port 5432 on the pooler host),
# not the transaction pooler on 6543 and not the IPv6-only direct connection:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode any symbols in the password (@ -> %40, # -> %23).
# See docs/DEPLOYMENT.md.

# Managed Postgres (Supabase, Render, ...) only accepts TLS connections.
DATABASE_SSL=false

# Port the REST API listens on
PORT=3000

# Origins allowed by CORS, comma-separated. The browser blocks any response
# whose Access-Control-Allow-Origin does not match the page's own origin, and
# that surfaces in the SPA only as a generic network error - so list every
# origin the app is served from, with no trailing slash.
#   local start.sh      -> http://localhost:5173
#   local `next dev`    -> http://localhost:3001 (3000 is taken by this API)
#   deployed            -> https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Set to true to log every SQL statement
DB_LOGGING=false
